# ─────────────────────────────────────────────────────────────
# MetaForge configuration. Copy to .env.local and fill in.
# Never commit real keys — .env.local is git-ignored.
# README.md lists every setting. A number left out or empty takes its default.
# ─────────────────────────────────────────────────────────────

# Riot API key from https://developer.riotgames.com
# Development keys expire every 24 hours; a public site needs a production key.
RIOT_API_KEY=

# Postgres connection string (Neon, Supabase, local Postgres...). Needed on Vercel.
# Without it, matches are stored in ./.data (fine for one long-running server).
DATABASE_URL=
# Connections per server instance (default 6, 2 on Vercel)
# DATABASE_POOL_MAX=6

# Public address of the site, with https:// in production. Canonical links, the
# sitemap, robots.txt, link previews and Riot Sign-On redirects are built on it.
APP_URL=http://localhost:3000

# Secrets — the setup script generates these for you.
# CRON_SECRET protects /api/cron/ingest; SESSION_SECRET signs sign-in sessions
# (CRON_SECRET is used when it is empty).
CRON_SECRET=
SESSION_SECRET=

# ── Optional: Riot Sign-On (requires an approved RSO client) ──
RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=
# Defaults to ${APP_URL}/auth/callback
RIOT_REDIRECT_URI=

# ── Match collection ──
# Platforms to collect from: comma list or "all"
# (na1, euw1, eun1, kr, jp1, br1, la1, la2, oc1, tr1, ru, me1, sg2, tw2, vn2)
INGEST_REGIONS=na1,euw1,kr,eun1
# Collection while the server runs (minutes, 0 = off). On Vercel the cron in vercel.json runs it.
INGEST_INTERVAL_MINUTES=20
# Ladder players sampled and new matches fetched per region per run
INGEST_PLAYERS_PER_REGION=10
INGEST_MATCHES_PER_REGION=40
# Time budget of one run in seconds (default 270 on Vercel, 900 elsewhere)
# INGEST_BUDGET_SECONDS=900
# Delete stored matches older than this many days after each run (0 = keep all)
RETAIN_DAYS=30
# Newest boards the stats are built from (default 250000)
# MAX_BOARDS=250000
# Riot key rate limits to start from, "requests:seconds" pairs. The default fits a development
# key; a production key is 500:10,30000:600. After Riot's first answer MetaForge follows the
# limits Riot reports.
RIOT_RATE_LIMITS=20:1,100:120
# Send Riot API calls through a caching proxy instead ({host} = na1, americas, ...)
# RIOT_API_BASE_URL=https://{host}.api.riotgames.com

# ── Player directory (search by name) ──
# Each run also lists ranked players (Master and up, then Diamond to Iron division by division)
# and looks up their Riot IDs, so players can be found by name without their tag.
# Needs DATABASE_URL: without a database the listing stays off.
# Division pages read per region per run (0 to 200, 0 = off)
CRAWL_PAGES=200
# Riot IDs looked up per run
CRAWL_NAMES=20000
# Percent of each run's time budget kept for the directory (0 to 90); matches get the rest
CRAWL_SHARE=50

# ── Advanced ──
# Set to track (default 18)
# TFT_SET=18
# Game data source, or a local CommunityDragon-format JSON file used instead of the network
# STATIC_DATA_URL=https://raw.communitydragon.org/latest/cdragon/tft/en_us.json
# STATIC_DATA_FILE=
# Folder for local match storage and caches (default .data, /tmp/metaforge on Vercel)
# DATA_DIR=.data
